# Copy this file to .env (repo root) and fill in real values for a
# docker-compose deployment. Never commit .env. See also server/.env.example,
# client/.env.example, and admin/.env.example for each app's own settings.

# --- Caddy reverse proxy / TLS (see Caddyfile) ---
# Real, publicly resolvable domains that already point at this host's public
# IP. Caddy automatically obtains and renews Let's Encrypt certificates for
# each. Leave unset for local testing only (falls back to plain localhost
# ports with an untrusted local-CA cert — see Caddyfile).
CLIENT_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# --- Browser-facing API URL, baked into the client/admin builds ---
# Should match https://<API_DOMAIN> above once that's set.
VITE_API_URL=https://api.example.com

# --- Cloudinary (admin image uploads from the browser) ---
VITE_CLOUDINARY_CLOUD=your-cloud-name
VITE_CLOUDINARY_PRESET=your-upload-preset
