# Copy this file to .env and fill in real values. Never commit .env.

# Base URL the browser uses to reach the API. Baked into the production
# build at build time, same as the client app (see admin/Dockerfile).
VITE_API_URL=http://localhost:5000

# Cloudinary unsigned upload preset — the admin panel uploads images directly
# from the browser to Cloudinary using this, bypassing the server entirely.
VITE_CLOUDINARY_CLOUD=your-cloud-name
VITE_CLOUDINARY_PRESET=your-unsigned-upload-preset
