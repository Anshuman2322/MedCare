# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# MongoDB connection string (Atlas or self-hosted). The server can start
# without this (read-only fallback data), but write operations and admin
# features need a real connection.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGO_DB=medcare

PORT=5000
NODE_ENV=development

# --- Auth ---
# Required. Minimum 16 chars (server refuses to start below that); 32+ chars
# recommended for production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=1d

# Optional: enables logging in as a super_admin when MongoDB is unreachable.
# Leave both unset to disable this fallback entirely (recommended unless you
# specifically need it) — there is no default password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Admin login lockout tuning (optional, defaults shown)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API in
# production. http://localhost:5173/5174/5175/4173 are always allowed for
# local dev regardless of this value.
CORS_ORIGINS=https://your-client-domain.com,https://your-admin-domain.com

# --- Rate limiting (optional, defaults shown) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Per-IP caps for admin password reset: code requests, and failed code/token submissions.
PASSWORD_RESET_RATE_LIMIT_MAX=10
OTP_VERIFY_RATE_LIMIT_MAX=20
INQUIRY_RATE_LIMIT_MAX=30
# Support chat writes a document per message, so it gets its own ceiling.
CHAT_RATE_LIMIT_MAX=120
# Customer reviews posted per IP per hour (default 5).
# REVIEW_RATE_LIMIT_MAX=5

# --- Cloudinary (product image uploads) ---
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET=your-cloudinary-api-secret

# --- Resend (team notifications, customer inquiry confirmations, password-reset codes) ---
RESEND_API_KEY=re_your_resend_api_key
# The one inbox for everything visitors do on the website: inquiries,
# best-price requests, contact messages and support-chat handoffs. Nothing is
# copied to any other address. Customers' replies to their inquiry
# confirmation also come here.
ADMIN_EMAIL=admin@example.com
# onboarding@resend.dev can only deliver to your own Resend account's address.
# Password-reset codes go to each admin's email, so production needs a sender
# on a domain verified in Resend, e.g. "CureNeed <no-reply@yourdomain.com>".
RESEND_FROM="CureNeed <onboarding@resend.dev>"
# Optional: the storefront address for links in inquiry emails.
# Defaults to https://www.cureneed.com
# PUBLIC_SITE_URL=https://www.cureneed.com

# --- Twilio WhatsApp alerts (optional) ---
# Leave these unset/placeholder to keep WhatsApp alerts disabled (the server
# logs this clearly at boot either way). TWILIO_ACCOUNT_SID must be a real
# "AC" + 32 hex character SID, not the literal placeholder below.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886
ADMIN_WHATSAPP_TO=+10000000000
# Set to "false" to force-disable even with real credentials configured.
WHATSAPP_ALERTS_ENABLED=true

# --- Claude (support chat + review drafts) ---
# Optional. With a key, Claude (claude-opus-5-5) answers the support chat in
# natural language (grounded in the live catalogue and the site's own facts)
# and writes the "Write it for me" review drafts. Without one, or whenever a
# call fails, the built-in rule-based assistant and draft writer are used.
# Server-side only, never sent to browsers.
# ANTHROPIC_API_KEY=
# Set to "off" to keep the chat on the rule-based assistant even with a key.
# CHAT_AI=off
# Draft requests per IP per hour (default 20).
# REVIEW_SUGGEST_RATE_LIMIT_MAX=20

# --- Logging ---
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Misc ---
# Set to "system" to use the host's default DNS resolver instead of the
# built-in 8.8.8.8/8.8.4.4 fallback (only relevant if your network's default
# resolver can't reach MongoDB Atlas's SRV records).
DNS_SERVERS=system
