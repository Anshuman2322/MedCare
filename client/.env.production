# Production API address, used by `vite build` only (never by `npm run dev`).
# Committed on purpose: it is a public URL, not a secret, and it guarantees the
# deployed storefront never falls back to http://localhost:5000.
#
# Precedence: a VITE_API_URL set in the build environment (Vercel project
# settings, Docker build arg) overrides this file. Docker builds don't see this
# file at all (.dockerignore excludes .env.*) and keep using their build arg.
VITE_API_URL=https://medcare-o43u.onrender.com
