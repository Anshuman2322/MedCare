# Copy this file to .env and fill in real values. Never commit .env.

# Base URL the browser uses to reach the API. For a Vite dev server this is
# read at dev-server-start time; for a production build it's baked into the
# bundle at build time (see client/Dockerfile).
VITE_API_URL=http://localhost:5000

# Optional: the storefront's public address, used for links in the inquiry PDF.
# Defaults to https://www.cureneed.com
# VITE_PUBLIC_SITE_URL=https://www.cureneed.com
